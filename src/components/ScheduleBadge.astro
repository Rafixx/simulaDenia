---
import type { SectionMeta } from "../data/types";
import { useTranslations } from "../utils/languageStore";

interface Props {
  schedule: NonNullable<SectionMeta["schedule"]>;
}

const { schedule } = Astro.props;
const t = useTranslations();

const label = t.scheduleBadge[schedule];

const colorClasses: Record<Props["schedule"], string> = {
  laboral: "bg-blue-500 dark:bg-blue-600",
  fueraLaboral: "bg-purple-400 dark:bg-purple-600"
};
---

<span
  class={`absolute top-3 right-3 z-10 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold text-white shadow-md ${colorClasses[schedule]}`}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/>
    <polyline points="12 6 12 12 16 14"/>
  </svg>
  <span data-i18n={`scheduleBadge.${schedule}`}>{label}</span>
</span>
